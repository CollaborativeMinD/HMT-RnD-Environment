  "findings": [
    {
      "id": "P1-MA-001",
      "disposition": "SCOPED_EVIDENCE_SUPPORTED",
      "subject": "MCP trusted identity and fresh operation checks",
      "requirements": [
        "HMT-F02",
        "HMT-F03",
        "HMT-F17",
        "HMT-F20"
      ],
      "source_observation": "LaneBinding is host-loaded, frozen and strict. Identity/task/revision/root/destination/policy are outside protocol arguments. Same opened config descriptor is owner/type/write-permission checked and bounded. Discovery and invocation call common current host admission; unknown tools cannot invoke hidden custody/administration operations. Handoff PASS is reported data and acceptance_granted remains false.",
      "execution_evidence": "mcp_stdio.json reports18 real official SDK client/stdio tests. Tests cover revoke after discovery, cached tool call denial, policy/revision changes, identity substitutions, hidden/malformed tools, closed schema metadata, launch descriptor substitution, and oversized real frames. Current advertised argument schemas derive from the same strict runtime models.",
      "limits": "Only inspect_context and validate_handoff are exposed. No lifecycle mutation or effect execution is admitted. Protected launcher/parents/DB/root remain OS prerequisites; no malicious same-UID host isolation or remote HTTP authentication claim."
    },
    {
      "id": "P1-MA-002",
      "disposition": "SOURCE_GAP_REPAIRED_WITH_SCOPED_NEW_WITNESSES",
      "subject": "Immutable lane receipts and preserved artifact bytes",
      "requirements": [
        "HMT-F17",
        "HMT-B07",
        "HMT-B10"
      ],
      "source_observation": "Initial lane implementation made SQL metadata immutable but merely referenced mutable artifact/evidence paths. Current derivative atomically snapshots bounded content-addressed artifact/evidence BLOBs with receipt and host checkpoint; snapshot retrieval verifies digest and per-stage aggregate limit. Typed reopening appends invalidations, routes to earliest current drift owner, retains original SEALED/DENIED records and requires a bound typed successor.",
      "execution_evidence": "Prior14-test evidence/JUnit are retained. Current lane JUnit records17 tests with zero errors/failures/skips, including mutation of artifact and gate evidence followed by exact original byte recovery after reopen for both SEALED and DENIED, plus aggregate overflow rollback.",
      "limits": "Initial artifact gap was source-observed; reviewer did not execute a failing counterexample. No arbitrary privileged SQLite/filesystem attacker protection, cross-stage domain completeness, or full lifecycle transport qualification is established."
    },
    {
      "id": "P1-MA-003",
      "disposition": "SCOPED_MECHANISM_SUPPORTED_DOMAIN_GATES_UNQUALIFIED",
      "subject": "Gate evaluator execution versus wire PASS declarations",
      "requirements": [
        "HMT-F12",
        "HMT-F20"
      ],
      "source_observation": "Lane submission requires an evaluator callback outside wire data. It actually invokes evaluator(GateContext), verifies exact current artifact/ancestor/policy/epoch/evidence, repeats admission inside the same host transaction, preserves bytes, and records the receipt. Missing evaluator, substituted gate context and expiry during callback are denied.",
      "execution_evidence": "Controlled test evaluator reads exact artifact bytes, executes an assertion and writes hashed evidence; the final lane tests exercise invocation and rechecks.",
      "limits": "Controlled evaluator is not a qualified CMAD/PMCT/DOKE/MR/CSSI/IIEA/Build/OPS gate implementation. Actual domain task-to-mission lineage, configured stage gate commands, completion firewall and human closeout remain to bind. Trusted callbacks must not become fixture PASS substitutes."
    },
    {
      "id": "P1-MA-004",
      "disposition": "SCOPED_EXPERIMENT_SUPPORTED",
      "subject": "Named causal edge and two process interruption cuts",
      "requirements": [
        "HMT-F02",
        "HMT-F18",
        "HMT-N05",
        "HMT-N07",
        "HMT-B01",
        "HMT-B03",
        "HMT-B06",
        "HMT-B12"
      ],
      "source_observation": "Family contains intact/local deletion/restoration/sham/alternate compensation on/off arms. Faulty arms must both match their declared observation and violate the unchanged revoked-safety oracle; redundancy does not hide the local reservation state change. Actual subprocesses are killed after reserve and after endpoint commit. Reopen uses fresh explicit fixture authority and exact signed endpoint proof, reconciled twice without a second apply.",
      "execution_evidence": "Stable p1_causal_temporal.json reports9 passing tests and all raw arms/two process witnesses, with before/after source stability asserted.",
      "limits": "One edge, two cuts, fixture clock and local endpoint key realm only. No power/host loss, hardware trusted-time, live vendor proof, all causal edges or exhaustive execution coverage."
    },
    {
      "id": "P1-MA-005",
      "disposition": "BOUNDED_PUBLIC_SOURCE_REVIEW_NO_PROPRIETARY_BODY_IDENTIFIED",
