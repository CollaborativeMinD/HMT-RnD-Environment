{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HMT operation binding design record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "allowed_stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "effect_class": {
      "enum": [
        "READ",
        "LOCAL_MUTATION",
        "EXTERNAL_MUTATION",
        "EVALUATION"
      ]
    },
    "implementation_route": {
      "type": "string",
      "minLength": 1
    },
    "reference_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_pin": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_schema_pin": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_schema_pin": {
      "type": [
        "string",
        "null"
      ]
    },
    "credential_scope_and_data_egress": {
      "$ref": "#/$defs/credential"
    },
    "retry_reconciliation_owner": {
      "$ref": "#/$defs/retry"
    },
    "requirement_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "resource_profile": {
      "enum": [
        "LOCAL-CTRL-1",
        "MODEL-PROFILE-REQUIRED"
      ]
    },
    "evidence_contract": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "readiness": {
      "enum": [
        "DESIGN_PINNED_EXECUTION_BLOCKED"
      ]
    },
    "unresolved_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proposed_principal": {
          "type": "string"
        },
        "resolved_identity_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "credential_handle_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "permitted_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resource_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_classification": {
          "type": "string"
        },
        "permitted_payload_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "destination_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_data": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "redaction_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "redirect_policy": {
          "const": "DENY_UNLESS_REVALIDATED"
        },
        "revocation_owner": {
          "const": "Host/CSSI"
        },
        "default": {
          "const": "DENY_EGRESS_UNTIL_BOUND"
        }
      },
      "required": [
        "proposed_principal",
        "resolved_identity_ref",
        "credential_handle_ref",
        "permitted_actions",
        "resource_allowlist",
        "data_classification",
        "permitted_payload_fields",
        "destination_allowlist",
        "forbidden_data",
        "redaction_ref",
        "redirect_policy",
        "revocation_owner",
        "default"
      ]
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string"
        },
        "effect_identity": {
          "type": "string"
        },
        "attempt_identity": {
          "type": "string"
        },
        "reservation_identity": {
          "type": "string"
        },
        "automatic_retry": {
          "type": "boolean"
        },
        "maximum_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "deadline_policy": {
          "type": "string"
        },
        "terminal_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertain_completion": {
          "type": "string"
        },
        "proof_requirement": {
          "type": "string"
        },
        "alternate_provider_rule": {
          "type": "string"
        }
      },
      "required": [
        "owner",
        "effect_identity",
        "attempt_identity",
        "reservation_identity",
        "automatic_retry",
        "maximum_attempts",
        "deadline_policy",
        "terminal_conditions",
        "uncertain_completion",
        "proof_requirement",
        "alternate_provider_rule"
      ]
    }
  },
  "required": [
    "operation_id",
    "owner",
    "allowed_stages",
    "effect_class",
    "implementation_route",
    "reference_surfaces",
    "source_pin",
    "input_schema_pin",
    "output_schema_pin",
    "credential_scope_and_data_egress",
    "retry_reconciliation_owner",
    "requirement_refs",
    "resource_profile",
    "evidence_contract",
    "readiness",
    "unresolved_bindings"
  ]
}
