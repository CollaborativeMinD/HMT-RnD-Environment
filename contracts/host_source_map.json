  "blockers": [
    {
      "id": "GAP-RECONCILE-PROOF-001",
      "requirements": [
        "HMT-B03",
        "HMT-B04",
        "HMT-F02"
      ],
      "gap": "Generic reconcile evidence lacks authenticated endpoint proof and fresh authority.",
      "closure": "Do not expose hmt_framework.capability_claims.reconcile. Bind existing transactional custody reserve/reconcile and endpoint.lookup_or_cancel with exact-effect/reservation proof, fresh grant, and durable cancellation checks. Reopen integration satisfaction claims; requirement contracts remain unchanged."
    },
    {
      "id": "GAP-LANE-INTERSECTION-001",
      "requirements": [
        "HMT-F01",
        "HMT-F02",
        "HMT-F20"
      ],
      "gap": "Existing actor role/scope/epoch contracts do not themselves bind this build\u2019s exact lane/stage/credential/egress projection.",
      "closure": "Map current host authority and prove direct/MCP cross-lane negatives; never create another authorizer/task database."
    },
    {
      "id": "GAP-POST-EFFECT-HOLD-001",
      "requirements": [
        "HMT-F18",
        "HMT-B03",
        "HMT-B06"
      ],
      "gap": "Post-effect audit or corrective filesystem delivery can fail after committed state.",
      "closure": "Preserve effect identity/uncertainty; transactionally persist required delivery intent in owning domain. Never retry mutation solely because wrapper returns HOLD."
    },
    {
      "id": "GAP-STANDALONE-AUTH-001",
      "requirements": [
        "HMT-F02",
        "HMT-F04"
      ],
      "gap": "Baseline standalone dispatch does not authenticate transport principal; mission-free reads bypass native scope admission.",
      "closure": "Use host authenticated principal and per-call roots/evidence scope, not caller-reported agent IDs."
    },
    {
      "id": "GAP-REPLAY-RANGE-001",
      "requirements": [
        "HMT-N12"
      ],
      "gap": "LIMIT 4096 verification cannot attest completeness of longer chain.",
      "closure": "Report exact verified range and continuation/total bounds; test events after 4096."
    },
    {
      "id": "GAP-RESOURCE-PROFILE-001",
      "requirements": [
        "HMT-F03",
        "HMT-N02",
        "HMT-N03",
        "HMT-N08"
      ],
      "gap": "Capability payload bound is 16384 bytes; subprocess RLIMIT_AS is 1-2 GiB; native policy timeouts differ from proposed gateway profile.",
      "closure": "Preserve stricter valid input bounds; qualify operation profiles, distinguish address space from RSS, and never claim inherited modules meet new structural bands without measurement."
    }
  ],
  "adapter_plan": [
    {
      "step": 1,
      "seam": "Provision derivative HostStore once under trusted host control; bind authenticated transport identity separately from wire Request."
    },
    {
      "step": 2,
      "seam": "Direct and MCP request handlers call common strict derivative admission; no raw reference package calls."
    },
    {
      "step": 3,
      "seam": "Custody derivative begins IMMEDIATE on same database and calls read-only host_checks.authorize on that exact connection; host mutations use same SQLite write fence."
    },
    {
      "step": 4,
      "seam": "No effect dispatcher until custody and current authorization are atomically composed; admission Decision grants no executable effect token."
    },
    {
      "step": 5,
      "seam": "Extend tracer-bound standalone derivative to needed lane/stage/task behavior while preserving fixed requirement contracts and reference provenance."
    }
  ],
  "unknowns": [
    "Production transport identity binding and credential provider remain deployment obligations.",
    "Host and custody atomic composition still requires integrated causal/revoke/restart witnesses.",
    "No current implementation claims all 26 stage transitions, full completion firewall, egress sandbox, or public-method classification closure.",
    "Source-derived behaviors are implemented independently; reference packages must not become runtime dependencies."
  ],
